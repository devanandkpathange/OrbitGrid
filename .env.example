# ================================================================
# GridPoint — Environment Configuration & API Keys
# ================================================================
# By default, GridPoint runs in 100% FREE MODE (₹0 cost) using
# OpenStreetMap, CartoDB, and OSRM with calibrated Indian circuity.
# 
# If you have your own API keys, add them below to activate premium features.
# ================================================================

# Optional Google Maps API Key (for Google Geocoding & Distance Matrix)
GOOGLE_MAPS_API_KEY=

# Optional Mapbox Access Token (for Mapbox High-Res Satellite/Vector Tiles)
MAPBOX_ACCESS_TOKEN=

# Optional OpenRouteService API Key
OPENROUTESERVICE_API_KEY=

# Port and Host
PORT=8000
HOST=0.0.0.0
